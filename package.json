{
  "name": "@kubohiroya/turbowarp-web-speech",
  "version": "0.2.0",
  "description": "Browser speech recognition and speech synthesis (Web Speech API) for TurboWarp, with a Composition API.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-web-speech#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-web-speech.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-web-speech/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "speech",
    "speech-recognition",
    "text-to-speech",
    "web-speech-api",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "schemas"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.composition.config.ts && tsc --project tsconfig.build.json",
    "lint": "eslint src tests scripts vite.config.ts vite.composition.config.ts eslint.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/generate-readme.ts --check",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run types:composition:check && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "types:composition:check": "tsc --project tsconfig.composition-consumer.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.3.2",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.8.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.3.4"
  },
  "exports": {
    "./composition": {
      "types": "./dist/types/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./turbowarp-web-speech.js": "./dist/turbowarp-web-speech.js",
    "./package.json": "./package.json"
  },
  "gitHead": "344bdb255658b2322158e0c07f3357f1788f8ee7",
  "x-turbowarp-source": {
    "revision": "344bdb255658b2322158e0c07f3357f1788f8ee7",
    "revisionRole": "base-commit",
    "sourceState": "working-tree-release-overlay"
  }
}
