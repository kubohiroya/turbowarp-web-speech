{
  "name": "@kubohiroya/turbowarp-web-speech",
  "version": "0.6.1",
  "description": "Browser speech recognition and speech synthesis (Web Speech API) for TurboWarp, with a Composition API.",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-web-speech#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-web-speech.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-web-speech/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "speech",
    "speech-recognition",
    "text-to-speech",
    "web-speech-api",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "schemas"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.composition.config.ts && tsc --project tsconfig.build.json",
    "lint": "eslint src tests scripts vite.config.ts vite.composition.config.ts eslint.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/generate-readme.ts --check",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run types:composition:check && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "types:composition:check": "tsc --project tsconfig.composition-consumer.json",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.6.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.11.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.11.4"
  },
  "exports": {
    "./composition": {
      "types": "./dist/types/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./turbowarp-web-speech.js": "./dist/turbowarp-web-speech.js",
    "./package.json": "./package.json"
  },
  "gitHead": "d576d09a4388fdafce6a0a639f634bd6d0ddf1a5",
  "x-turbowarp-source": {
    "revision": "d576d09a4388fdafce6a0a639f634bd6d0ddf1a5",
    "revisionRole": "base-commit",
    "sourceState": "working-tree-release-overlay"
  },
  "turbowarpExtension": {
    "resourceDeclaration": {
      "schemaVersion": 1,
      "resources": [
        {
          "type": "microphone",
          "usage": "conditional",
          "purpose": {
            "en": "Capture audio for browser speech recognition",
            "ja": "ブラウザの音声認識用に音声を取得する"
          },
          "condition": {
            "en": "When speech recognition is started",
            "ja": "音声認識を開始する場合"
          }
        },
        {
          "type": "network",
          "usage": "conditional",
          "purpose": {
            "en": "Use the browser speech recognition service",
            "ja": "ブラウザの音声認識サービスを利用する"
          },
          "condition": {
            "en": "When the browser uses server-based recognition; this depends on the browser and service",
            "ja": "ブラウザがサーバーで音声認識する場合。ブラウザとサービスに依存する"
          },
          "data": {
            "direction": "bidirectional",
            "content": {
              "en": "Microphone audio sent to the browser recognition provider and recognized text returned",
              "ja": "ブラウザの認識サービス提供元へ送るマイク音声と、返される認識テキスト"
            }
          }
        },
        {
          "type": "audio-output",
          "usage": "conditional",
          "purpose": {
            "en": "Read text aloud with browser speech synthesis",
            "ja": "ブラウザの音声合成でテキストを読み上げる"
          },
          "condition": {
            "en": "When speech synthesis is requested",
            "ja": "読み上げを実行する場合"
          }
        }
      ]
    }
  }
}
